% rebase('base.tpl', title='Success Page')
<div class="success-center">
  <div class="container text-center">
    <div class="row justify-content-center">
      <!-- usa col-11 su xs per dare un po' di respiro, poi dimensioni responsive -->
      <div class="col-11 col-md-8 col-lg-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h1 class="card-title text-success">Booking Confirmed!</h1>
            <p class="lead">Your appointment has been successfully booked.</p>
            <a href="/" class="btn btn-primary mt-3">Book Another Appointment</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>